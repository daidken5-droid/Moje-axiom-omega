<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="#F1F3F5" android:centerColor="#6F757E" android:endColor="#C3C8CF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#0B0C10" />
        </shape>
    </item>
</layer-list>
